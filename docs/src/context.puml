@startuml context
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()

title Диаграмма системного контекста C4 (Level 1) — ИС «Интеллектуальная библиотека»

' === ПЕРСОНЫ (пользовательские роли) ===
Person(reader, "Читатель", "Житель города. Ищет издания в едином каталоге, бронирует книги, читает электронный фонд, участвует в форумах, подаёт заявки на комплектование и голосует за них, оплачивает штрафы.")
Person(librarian, "Библиотекарь", "Сотрудник отдела обслуживания. Регистрирует читателей, выдаёт и принимает издания, контролирует брони и просрочки.")
Person(acquisitor, "Специалист по комплектованию", "Сотрудник отдела комплектования. Каталогизирует и списывает издания, рассматривает заявки читателей, анализирует востребованность фонда.")
Person(admin, "Администратор библиотеки", "Представитель администрации. Формирует отчётность, управляет учётными записями сотрудников и настройками системы.")
Person(moderator, "Модератор сообщества", "Следит за порядком на форумах: проверяет жалобы, скрывает нарушающие правила сообщения, блокирует нарушителей.")

' === ПРОЕКТИРУЕМАЯ СИСТЕМА ===
System(library_system, "ИС «Интеллектуальная библиотека»", "Единый каталог бумажного и электронного фонда, автоматизированная выдача и возврат, бронирование, штрафы, личный кабинет, форумы, заявки на комплектование и анализ востребованности по мировым и внутренним трендам.")

' === ВНЕШНИЕ СИСТЕМЫ (вне зоны контроля разработчиков) ===
System_Ext(payment_gateway, "Платёжный шлюз", "Внешний эквайринг (ЮKassa / СБП). Приём безналичной оплаты штрафов.")
System_Ext(trends_api, "Внешние источники трендов", "Открытые книжные API (Google Books API, Open Library). Рейтинги популярности и метаданные изданий.")
System_Ext(neb_catalog, "Сводный каталог НЭБ", "Национальная электронная библиотека. Источник готовых библиографических записей в формате RUSMARC.")
System_Ext(mail_service, "Почтовый сервис", "Внешний SMTP-провайдер. Доставка e-mail уведомлений читателям.")

' === СВЯЗИ ===
Rel(reader, library_system, "Ищет и бронирует издания, читает e-книги, общается на форумах, подаёт заявки и голосует, оплачивает штрафы", "HTTPS")
Rel(librarian, library_system, "Регистрирует читателей, оформляет выдачу и возврат изданий", "HTTPS")
Rel(acquisitor, library_system, "Каталогизирует и списывает издания, обрабатывает заявки, смотрит аналитику востребованности", "HTTPS")
Rel(admin, library_system, "Получает отчёты, управляет учётными записями и настройками", "HTTPS")
Rel(moderator, library_system, "Рассматривает жалобы, модерирует сообщения и темы форумов", "HTTPS")

Rel(library_system, payment_gateway, "Создаёт платёж по штрафу читателя", "HTTPS / REST API")
Rel(payment_gateway, library_system, "Уведомляет о результате оплаты (webhook)", "HTTPS / JSON")
Rel(library_system, trends_api, "Запрашивает рейтинги популярности и метаданные книг", "HTTPS / REST API")
Rel(library_system, neb_catalog, "Импортирует библиографические записи", "Z39.50 / TCP 210")
Rel(library_system, mail_service, "Отправляет уведомления о сроках возврата, бронях и штрафах", "SMTP / TLS 587")
Rel(mail_service, reader, "Доставляет e-mail уведомления", "SMTP / IMAP")

@enduml
