@startuml glimakova-container
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Диаграмма контейнеров (C4 Level 2) - Интеллектуальная библиотека

' === АКТОРЫ (Персоны) ===
Person(reader, "Читатель", "Посетитель библиотеки. Ищет и бронирует издания, инициирует заявки на пополнение фонда, участвует в голосованиях и общается на форумах")
Person(librarian, "Библиотекарь", "Штатный сотрудник. Занимается обработкой заявок читателей и отвечает за актуализацию книжного фонда")
Person(admin, "Администратор", "Представитель администрации. Осуществляет общее руководство платформой и контроль показателей эффективности")
Person(guest, "Гость", "Анонимный пользователь. Имеет доступ к публичному каталогу и рейтингам популярных изданий без необходимости авторизации")
Person(acquisition_staff, "Сотрудник отдела комплектования", "Специалист по фондам. Выполняет приемку, каталогизацию и списание литературы, а также курирует запросы на пополнение")

' === ГРАНИЦА СИСТЕМЫ И КОНТЕЙНЕРЫ ===
System_Boundary(library_system, "Интеллектуальная библиотека") {
  Container(web_app, "Web-приложение", "React", "Клиентское приложение, предоставляющее графический интерфейс для взаимодействия пользователей с системой")
  Container(backend_api, "Backend API", "Node.js", "Центральный сервис, инкапсулирующий бизнес-логику, обработку транзакций и маршрутизацию запросов")
  Container(ml_service, "ML-сервис", "Python", "Выделенный вычислительный модуль для анализа трендов и прогнозирования востребованности литературы")
  ContainerDb(database, "База данных", "PostgreSQL", "Реляционное хранилище структурированных данных о фонде, пользователях и операциях")
  ContainerDb(cache, "Кэш", "Redis", "Быстрое хранилище для кэширования каталогов и сессий пользователей")
  Container(file_storage, "Хранилище электронных книг", "RustFS / S3", "Объектное хранилище для размещения полнотекстовых версий изданий и медиафайлов")
}

' === ВНЕШНИЕ СИСТЕМЫ ===
System_Ext(trend_service, "Сервис мировых трендов", "Сторонняя платформа, предоставляющая актуальные данные о книжных трендах и популярных изданиях (Open Library)")
System_Ext(email_service, "Сервис email-рассылок", "Уведомления читателям о готовности заявок, сроках возврата бумажных книг, ответах на форумах (Яндекс.Почта)")
System_Ext(payment_gateway, "Банковский эквайринг", "Внешний процессинговый центр для проведения транзакций по оплате штрафов за задержку возврата литературы (Тинькофф)")

' === СВЯЗИ ===
' Взаимодействие пользователей с Web-приложением
Rel(reader, web_app, "Изучает литературу, ведет дискуссии, влияет на формирование фонда", "HTTPS")
Rel(librarian, web_app, "Оформляет новых читателей, управляет выдачей и возвратом изданий", "HTTPS")
Rel(admin, web_app, "Администрирует платформу, отслеживает метрики", "HTTPS")
Rel(guest, web_app, "Знакомится с каталогом и рейтингами", "HTTPS")
Rel(acquisition_staff, web_app, "Курирует заявки на закупку, ведет учет новых поступлений", "HTTPS")

' Внутреннее взаимодействие контейнеров
Rel(web_app, backend_api, "Отправка запросов", "HTTPS/JSON")
Rel(backend_api, database, "Чтение и запись данных", "SQL/TCP")
Rel(backend_api, cache, "Кэширование данных", "Redis Protocol")
Rel(backend_api, file_storage, "Загрузка и выгрузка файлов", "HTTPS")
Rel(backend_api, ml_service, "Запрос аналитики", "gRPC / HTTPS")

' Взаимодействие ML-сервиса с внешними и внутренними системами
Rel(ml_service, trend_service, "Запрос данных о трендах", "REST API/HTTPS")
Rel(ml_service, database, "Сохранение результатов анализа", "SQL/TCP")

' Взаимодействие системы с внешними сервисами
Rel(backend_api, email_service, "Отправка уведомлений", "SMTP")
Rel(backend_api, payment_gateway, "Запрос на прием платежа", "REST API/HTTPS")

@enduml
