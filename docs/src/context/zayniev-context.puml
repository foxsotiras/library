@startuml "zayniev-context"
!include <C4/C4_Context.puml>
LAYOUT_WITH_LEGEND()

title Локальная диаграмма системного контекста (L1) — «Интеллектуальная библиотека»

Person(guest, "Гость", "Просматривает каталог и тренды без регистрации")
Person(reader, "Читатель", "Ищет книги, подаёт заявки, участвует в форуме")
Person(publisher, "Правообладатель / Издательство", "Загружает книги, получает статистику востребованности")

System(library, "Интеллектуальная библиотека", "Центральная система. Управляет фондом, обслуживает читателей, анализирует востребованность")

System_Ext(trends, "Сервис мировых трендов", "Внешний источник данных (например, Open Library)")
System_Ext(mail, "Сервис email-рассылок", "Уведомления читателям и издательствам")
System_Ext(bank, "Банковский эквайринг", "Приём оплаты штрафов")

Rel(guest, library, "Просматривает каталог и тренды", "HTTPS")
Rel(reader, library, "Ищет книги, подаёт заявки, участвует в форуме", "HTTPS")
Rel(publisher, library, "Загружает книги, запрашивает статистику", "HTTPS/REST")

Rel(library, trends, "Запрос данных о трендах", "REST API/HTTPS")
Rel(library, mail, "Отправка уведомлений", "SMTP")
Rel(library, bank, "Приём оплаты штрафов", "REST API/HTTPS")

@enduml
