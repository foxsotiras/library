@startuml buglak-context
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()

title Диаграмма системного контекста (C4 Level 1) - Электронная платформа библиотеки

' === АКТОРЫ ===
Person(guest, "Гость", "Неавторизованный посетитель. Просматривает публичный каталог, карточки изданий и рейтинг популярных книг")
Person(reader, "Читатель", "Зарегистрированный пользователь. Ищет и бронирует издания, читает электронные книги, подаёт заявки на закупку, оставляет отзывы, оплачивает штрафы")
Person(librarian, "Библиотекарь", "Сотрудник абонемента. Регистрирует читателей, оформляет выдачу и возврат, обрабатывает брони и начисляет штрафы")
Person(acquisition, "Комплектатор", "Сотрудник отдела комплектования. Принимает и списывает литературу, ведёт каталогизацию, рассматривает заявки на закупку")
Person(admin, "Администратор", "Управляет пользователями и ролями, настраивает платформу, контролирует аналитику и показатели работы библиотеки")

' === СИСТЕМА ===
System(library, "Электронная платформа библиотеки", "Единая веб-платформа: каталог и поиск, бронирование и выдача, электронные книги, заявки на закупку, штрафы, отзывы, аналитика спроса")

' === ВНЕШНИЕ СИСТЕМЫ ===
System_Ext(open_library, "Open Library", "Открытый API библиотечных данных: метаданные книг, обложки, сведения о популярных изданиях и трендах")
System_Ext(mail_provider, "Почтовый сервис (SMTP)", "Доставка писем: подтверждение регистрации, готовность брони, напоминания о сроке возврата, уведомления по заявкам")
System_Ext(payment, "ЮKassa", "Платёжный шлюз для приёма онлайн-оплаты штрафов за просрочку возврата изданий")
System_Ext(sso, "Внешний провайдер авторизации (OAuth 2.0)", "Вход через сторонний аккаунт (например, Яндекс ID) без создания отдельного пароля")

' === СВЯЗИ: ПОЛЬЗОВАТЕЛИ ===
Rel(guest, library, "Просматривает каталог и рейтинги", "HTTPS")
Rel(reader, library, "Ищет, бронирует, читает онлайн, подаёт заявки, платит штрафы", "HTTPS")
Rel(librarian, library, "Оформляет выдачу/возврат, обрабатывает брони", "HTTPS")
Rel(acquisition, library, "Ведёт фонд, рассматривает заявки на закупку", "HTTPS")
Rel(admin, library, "Администрирует платформу, смотрит аналитику", "HTTPS")

' === СВЯЗИ: ВНЕШНИЕ СИСТЕМЫ ===
Rel(library, open_library, "Запрашивает метаданные книг и данные о трендах", "REST/HTTPS, JSON")
Rel(library, mail_provider, "Отправляет уведомления пользователям", "SMTP/TLS")
Rel(library, payment, "Создаёт платёж за штраф", "REST/HTTPS, JSON")
Rel(payment, library, "Сообщает о статусе платежа", "Webhook/HTTPS")
Rel(library, sso, "Аутентифицирует пользователей", "OAuth 2.0 / OpenID Connect, HTTPS")

@enduml
