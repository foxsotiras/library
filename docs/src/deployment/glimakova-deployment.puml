@startuml glimakova-deployment
!include <C4/C4_Deployment>
LAYOUT_WITH_LEGEND()

title Развертывание — Портал читателя

Deployment_Node(device, "Рабочее устройство") {
  Container(reader_portal, "reader_portal", "Vue.js 3 SPA")
}

Deployment_Node(dmz, "Демилитаризованная зона") {
  Deployment_Node(nginx_a, "Nginx A", "TLS 1.3")
  Deployment_Node(nginx_b, "Nginx B", "TLS 1.3")
}

Container_Ext(api_gateway, "api_gateway", "NestJS")
Container_Ext(media_service, "media_service", "Fastify")

Rel(reader_portal, nginx_a, "Получает dist и вызывает API", "HTTPS 443")
Rel(reader_portal, nginx_b, "Обращается через VIP при отказе A", "HTTPS 443")
Rel(nginx_a, api_gateway, "Передает REST", "HTTPS 3000 / mTLS")
Rel(nginx_a, media_service, "Передает Range", "HTTPS 3100 / mTLS")
Rel(nginx_b, api_gateway, "Передает REST", "HTTPS 3000 / mTLS")
Rel(nginx_b, media_service, "Передает Range", "HTTPS 3100 / mTLS")
@enduml
