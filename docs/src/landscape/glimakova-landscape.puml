  System_Boundary(team_boundary, "Граница ответственности команды") {
    System(library, "Интеллектуальная библиотека", "Каталог, обслуживание, аналитика и электронный фонд")
  }

  System_Ext(iam, "Муниципальная IAM", "Проектная интеграция SSO")
}

System_Ext(payment_gateway, "Платежный шлюз", "Внешняя финансовая система")
