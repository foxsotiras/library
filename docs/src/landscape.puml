@startuml landscape
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()

title Системный ландшафт интеллектуальной библиотеки
footer Проектная интеграция. Локальные контейнеры раскрываются на L2.

Enterprise_Boundary(municipality, "Муниципальная цифровая среда") {
  System_Ext(city_portal, "Городской портал", "Переход к услугам библиотеки")
  System_Ext(municipal_iam, "Муниципальная IAM", "Проектная интеграция SSO")
  System_Boundary(library_it, "Граница ответственности команды") {
    System(library_system, "Интеллектуальная библиотека", "Каталог, обслуживание, аналитика и электронный фонд")
  }
}

System_Ext(payment_gateway, "Платежный шлюз", "Внешняя финансовая система")
System_Ext(neb_catalog, "Каталог НЭБ", "Библиографические записи")
System_Ext(trends_api, "Книжные API", "Метаданные и тренды")
System_Ext(mail_service, "Почтовый сервис", "Доставка уведомлений")

Rel(city_portal, library_system, "Переход к каталогу", "HTTPS 443")
Rel(library_system, municipal_iam, "Вход через SSO", "OIDC / HTTPS 443")
Rel(library_system, payment_gateway, "Создание платежа", "REST / HTTPS 443")
Rel(payment_gateway, library_system, "Статус оплаты", "Webhook / HTTPS 443")
Rel(library_system, neb_catalog, "Импорт записей", "Z39.50 / TCP 210 через VPN")
Rel(library_system, trends_api, "Снимок трендов", "REST / HTTPS 443")
Rel(library_system, mail_service, "Уведомления", "SMTP / STARTTLS 587")

@enduml
