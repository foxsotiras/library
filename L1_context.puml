@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml


title Диаграмма системного контекста C4 (Level 1) — Система «Интеллектуальная библиотека»

Person(guest, "Гость", "Просматривает каталог и анонсы без регистрации, может оставить заявку на гостевой доступ")
Person(chitatel, "Читатель", "Бронирует издания, ведёт личный кабинет, голосует за книги, общается на форумах")
Person(bibliotekar, "Библиотекарь", "Оформляет выдачу и возврат, ведёт фонд, обрабатывает заявки на комплектование")
Person(moderator, "Модератор форума", "Следит за порядком в обсуждениях, скрывает и удаляет сообщения, блокирует нарушителей")
Person(admin, "Администратор", "Управляет ролями и справочниками, смотрит аналитику востребованности")

System(biblio, "Интеллектуальная библиотека", "Управляет бумажным и электронным фондом, обслуживает читателей, анализирует тренды и поддерживает сообщество")

System_Ext(trends, "Сервис мировых трендов", "Источник данных о популярных изданиях (Open Library)")
System_Ext(email, "Сервис email-рассылок", "Доставляет уведомления о брони, сроках возврата и ответах на форуме (Яндекс.Почта)")
System_Ext(payment, "Банковский эквайринг", "Принимает онлайн-оплату штрафов за просрочку (Тинькофф)")
System_Ext(captcha, "Сервис капчи", "Защищает регистрацию и гостевые заявки от автоматических ботов (Google reCAPTCHA)")

Rel(guest, biblio, "Просматривает каталог, читает анонсы, оставляет заявку на гостевой доступ", "HTTPS")
Rel(chitatel, biblio, "Бронирует издания, голосует за книги, пишет на форуме, оплачивает штрафы", "HTTPS")
Rel(bibliotekar, biblio, "Оформляет выдачу и возврат, редактирует карточки фонда", "HTTPS")
Rel(moderator, biblio, "Модерирует обсуждения, скрывает и удаляет сообщения, блокирует пользователей", "HTTPS")
Rel(admin, biblio, "Управляет ролями и справочниками, выгружает аналитику", "HTTPS")

Rel(biblio, trends, "Запрашивает данные о мировых трендах", "REST API/HTTPS")
Rel(biblio, email, "Отправляет уведомления и подтверждения", "SMTP")
Rel(biblio, payment, "Инициирует платёж и получает статус оплаты", "REST API/HTTPS")
Rel(biblio, captcha, "Проверяет капчу при регистрации и гостевых заявках", "REST API/HTTPS")

@enduml